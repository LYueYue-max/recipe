  {"id":"eu-french-onion-soup","title":"法式洋葱汤","cuisine":"欧洲菜 · 法国","mainIngredients":["洋葱","牛肉高汤","面包"],"seasonings":["黄油","白葡萄酒","百里香","格鲁耶尔奶酪","盐","黑胡椒"],"steps":["洋葱切丝，黄油小火炒 40 分钟至深褐色","倒白葡萄酒煮至酒精挥发","加牛肉高汤和百里香，煮 15 分钟","面包烤脆，铺在汤上，撒格鲁耶尔奶酪","烤箱焗至奶酪融化起泡"],"difficulty":"中等","time":"70 分钟","servings":"2 人份","dietTags":[],"optional":["蒜"],"notes":"洋葱要慢慢炒焦糖化，是汤的灵魂"},
  {"id":"eu-beef-bourguignon","title":"勃艮第红酒炖牛肉","cuisine":"欧洲菜 · 法国","mainIngredients":["牛腩","红葡萄酒","胡萝卜","蘑菇"],"seasonings":["培根","洋葱","蒜","百里香","月桂叶","面粉","黄油"],"steps":["牛腩切块，用红葡萄酒、香草腌 4 小时","培根煎香，牛肉煎至表面焦黄","加洋葱、胡萝卜、蒜炒软，撒面粉","倒腌料红酒和高汤，加百里香、月桂叶","小火炖 2 小时，最后加炒香的蘑菇"],"difficulty":"进阶","time":"180 分钟","servings":"4 人份","dietTags":[],"optional":["小洋葱"],"notes":"隔夜再吃风味更佳"},
