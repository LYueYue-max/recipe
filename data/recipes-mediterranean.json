  {"id":"med-greek-salad","title":"希腊沙拉","cuisine":"地中海菜 · 希腊","mainIngredients":["番茄","黄瓜","红洋葱","菲达奶酪","黑橄榄"],"seasonings":["橄榄油","红酒醋","牛至","盐","黑胡椒"],"steps":["番茄切块，黄瓜切丁，洋葱切薄片","所有蔬菜放入大碗","放上整块或大块菲达奶酪和黑橄榄","淋橄榄油和红酒醋","撒牛至、盐和黑胡椒，食用前拌匀"],"difficulty":"简单","time":"10 分钟","servings":"2 人份","dietTags":["vegetarian","gluten-free","low-sugar"],"optional":["青椒","酸豆"],"notes":"菲达奶酪整块放，吃时再切碎"},
  {"id":"med-moussaka","title":"希腊穆萨卡","cuisine":"地中海菜 · 希腊","mainIngredients":["茄子","牛肉末","土豆","牛奶"],"seasonings":["洋葱","蒜","番茄酱","肉桂","面粉","黄油","肉豆蔻"],"steps":["茄子切片，撒盐去水后煎软","牛肉末与洋葱、蒜、番茄酱、肉桂炒成肉酱","牛奶、黄油、面粉煮成白酱，加肉豆蔻","烤盘依次铺土豆、茄子、肉酱、茄子、白酱","烤 40 分钟至表面金黄"],"difficulty":"进阶","time":"80 分钟","servings":"4 人份","dietTags":[],"optional":["帕玛森奶酪"],"notes":"白酱要厚，才能定型"},
  {"id":"med-spanish-paella","title":"西班牙海鲜饭","cuisine":"地中海菜 · 西班牙","mainIngredients":["短粒米","虾","青口","鱿鱼","番茄"],"seasonings":["藏红花","红椒粉","洋葱","蒜","白葡萄酒","橄榄油","高汤"],"steps":["藏红花泡少量温水","平底锅炒洋葱、蒜和番茄至软","下鱿鱼和虾略煎，倒入白葡萄酒","加米和高汤，撒红椒粉和藏红花水","铺青口，小火煮 18 分钟，关火焖 5 分钟"],"difficulty":"中等","time":"45 分钟","servings":"3 人份","dietTags":["contains-seafood","gluten-free"],"optional":["豌豆","柠檬角"],"notes":"不要搅动米饭，让底部形成锅巴"},
  {"id":"med-italian-caprese","title":"意式卡布里沙拉","cuisine":"地中海菜 · 意大利","mainIngredients":["番茄","马苏里拉奶酪","罗勒"],"seasonings":["橄榄油","盐","黑胡椒","巴萨米克醋"],"steps":["番茄和马苏里拉切厚片","交替摆盘","铺新鲜罗勒叶","淋橄榄油和巴萨米克醋","撒盐和黑胡椒"],"difficulty":"简单","time":"10 分钟","servings":"2 人份","dietTags":["vegetarian","gluten-free","low-sugar"],"optional":["芝麻菜"],"notes":"番茄要选熟透的，风味才足"},
  {"id":"med-gazpacho","title":"西班牙冷汤","cuisine":"地中海菜 · 西班牙","mainIngredients":["番茄","黄瓜","青椒","面包"],"seasonings":["蒜","橄榄油","雪莉醋","盐"],"steps":["番茄、黄瓜、青椒切块","面包泡水软化","所有材料放入搅拌机","加蒜、橄榄油、雪莉醋和盐搅打至顺滑","冷藏 1 小时以上，食用时淋橄榄油"],"difficulty":"简单","time":"15 分钟（不含冷藏）","servings":"3 人份","dietTags":["vegetarian","low-sugar"],"optional":["洋葱"],"notes":"冷藏后风味更佳"},
  {"id":"med-ratatouille","title":"普罗旺斯杂菜煲","cuisine":"地中海菜 · 法国","mainIngredients":["茄子","西葫芦","番茄","彩椒"],"seasonings":["洋葱","蒜","百里香","罗勒","橄榄油","盐"],"steps":["所有蔬菜切块或切片","橄榄油炒洋葱和蒜","分别炒茄子、西葫芦、彩椒","加入番茄和香草，小火炖 30 分钟","撒新鲜罗勒，可热食或冷食"],"difficulty":"简单","time":"45 分钟","servings":"3 人份","dietTags":["vegetarian","gluten-free","low-sugar"],"optional":[],"notes":"冷食比热食更入味"},
  {"id":"med-pasta-puttanesca","title":"意式橄榄酸豆意面","cuisine":"地中海菜 · 意大利南部","mainIngredients":["意面","番茄","黑橄榄","酸豆"],"seasonings":["蒜","鳀鱼","辣椒","橄榄油","欧芹"],"steps":["意面煮至八分熟，留一碗面水","橄榄油炒蒜、鳀鱼和辣椒","加番茄、黑橄榄和酸豆炒成酱","下面条和少许面水翻拌","撒欧芹出锅"],"difficulty":"简单","time":"20 分钟","servings":"2 人份","dietTags":["contains-seafood"],"optional":["金枪鱼"],"notes":"鳀鱼是隐藏的咸鲜来源，不要省略"},
  {"id":"med-focaccia","title":"佛卡夏","cuisine":"地中海菜 · 意大利","mainIngredients":["面粉","酵母","橄榄油"],"seasonings":["盐","迷迭香","海盐"],"steps":["面粉、酵母、盐、水和橄榄油揉成软面团","发酵 1 小时至两倍大","烤盘抹油，面团铺平，手指按压出坑","淋橄榄油，撒迷迭香和海盐","烤 20 分钟至金黄"],"difficulty":"中等","time":"90 分钟","servings":"4 人份","dietTags":["vegetarian"],"optional":["小番茄","洋葱丝"],"notes":"面团含水量高，烤出来才蓬松"},
  {"id":"med-greek-souvlaki","title":"希腊烤肉串","cuisine":"地中海菜 · 希腊","mainIngredients":["猪里脊","皮塔饼","生菜"],"seasonings":["橄榄油","柠檬汁","蒜","牛至","盐","黑胡椒","酸奶"],"steps":["猪里脊切块，用橄榄油、柠檬汁、蒜、牛至腌 2 小时","串成烤肉串","炭火或平底锅煎烤至熟","皮塔饼加热，铺生菜和番茄","放肉串，淋酸奶黄瓜酱，卷起"],"difficulty":"简单","time":"30 分钟（不含腌制）","servings":"2 人份","dietTags":[],"optional":["洋葱","番茄"],"notes":"配 tzatziki 酸奶黄瓜酱最地道"},
  {"id":"med-spanish-tortilla","title":"西班牙土豆蛋饼","cuisine":"地中海菜 · 西班牙","mainIngredients":["土豆","鸡蛋","洋葱"],"seasonings":["橄榄油","盐"],"steps":["土豆切薄片，洋葱切丝，橄榄油小火煎软","鸡蛋打散，加盐","土豆洋葱沥油后拌入蛋液，静置 10 分钟","平底锅热油倒入蛋液","小火煎至两面金黄，内部微湿"],"difficulty":"中等","time":"35 分钟","servings":"2 人份","dietTags":["vegetarian","gluten-free"],"optional":["青椒"],"notes":"翻面时用盘子辅助，防止散开"},
  {"id":"med-moroccan-tagine","title":"摩洛哥塔吉锅炖鸡","cuisine":"地中海菜 · 摩洛哥","mainIngredients":["鸡腿","洋葱","柠檬","橄榄"],"seasonings":["姜","肉桂","孜然","姜黄","藏红花","香菜","柠檬腌菜"],"steps":["鸡腿用香料腌 30 分钟","塔吉锅或厚底锅炒洋葱","加鸡腿煎至上色","加水、柠檬腌菜和橄榄","小火炖 40 分钟，撒香菜"],"difficulty":"中等","time":"60 分钟","servings":"3 人份","dietTags":["gluten-free"],"optional":["杏干","鹰嘴豆"],"notes":"柠檬腌菜带来独特咸酸味"},
  {"id":"med-shakshuka-med","title":"地中海烤蛋","cuisine":"地中海菜 · 以色列","mainIngredients":["鸡蛋","番茄","彩椒"],"seasonings":["洋葱","蒜","孜然","红椒粉","菲达奶酪","香菜"],"steps":["炒洋葱、彩椒和蒜至软","加番茄、孜然和红椒粉煮成酱","挖坑打入鸡蛋","盖盖焖至蛋白凝固","撒菲达奶酪和香菜"],"difficulty":"简单","time":"25 分钟","servings":"2 人份","dietTags":["vegetarian","gluten-free"],"optional":["辣酱"],"notes":"配面包蘸着吃"},
  {"id":"med-seafood-risotto","title":"意式海鲜烩饭","cuisine":"地中海菜 · 意大利","mainIngredients":["意大利米","虾","青口","鱿鱼"],"seasonings":["洋葱","蒜","白葡萄酒","橄榄油","黄油","帕玛森奶酪","欧芹"],"steps":["炒洋葱和蒜至软","下米炒至微透明，倒白葡萄酒","分次加高汤，边加边搅拌","米快熟时加海鲜，煮 5 分钟","关火拌黄油和帕玛森，撒欧芹"],"difficulty":"中等","time":"35 分钟","servings":"2 人份","dietTags":["contains-seafood","gluten-free"],"optional":["藏红花"],"notes":"烩饭要有一点流动感，不要太干"},
  {"id":"med-turkish-meze","title":"土耳其开胃拼盘","cuisine":"地中海菜 · 土耳其","mainIngredients":["鹰嘴豆泥","茄子泥","酸奶","黄瓜"],"seasonings":["橄榄油","柠檬汁","蒜","红椒粉","薄荷"],"steps":["准备鹰嘴豆泥和茄子泥","黄瓜切条","酸奶加蒜和薄荷拌匀","分别装小碗摆放","淋橄榄油，撒红椒粉，配皮塔饼"],"difficulty":"简单","time":"20 分钟","servings":"3 人份","dietTags":["vegetarian","gluten-free"],"optional":["葡萄叶包饭"],"notes":"开胃菜组合，可按个人喜好调整"},
  {"id":"med-portuguese-bacalhau","title":"葡式盐鳕鱼","cuisine":"地中海菜 · 葡萄牙","mainIngredients":["盐鳕鱼","土豆","洋葱","鸡蛋"],"seasonings":["橄榄油","蒜","黑橄榄","欧芹"],"steps":["盐鳕鱼提前泡水 24 小时去盐，撕成小块","土豆切块煮熟","橄榄油炒洋葱和蒜","加鳕鱼和土豆翻炒","拌入炒蛋碎，撒黑橄榄和欧芹"],"difficulty":"中等","time":"40 分钟（不含泡发）","servings":"3 人份","dietTags":["contains-seafood","gluten-free"],"optional":[],"notes":"鳕鱼泡发时间要足够，否则过咸"},
  {"id":"med-italian-tiramisu","title":"提拉米苏","cuisine":"地中海菜 · 意大利","mainIngredients":["马斯卡彭","手指饼干","鸡蛋","咖啡"],"seasonings":["糖","可可粉","咖啡酒"],"steps":["蛋黄加糖打至发白，拌入马斯卡彭","蛋白打至硬性发泡，翻拌入奶酪糊","手指饼干蘸咖啡和咖啡酒","容器中铺一层饼干一层奶酪糊，重复","冷藏 4 小时，食用前撒可可粉"],"difficulty":"中等","time":"30 分钟（不含冷藏）","servings":"4 人份","dietTags":["vegetarian"],"optional":[],"notes":"冷藏过夜风味更融合"}
